{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hotswap",
  "version": "0.6.4",
  "identifier": "dev.gabriel.hotswap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hotswap",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "zoomHotkeysEnabled": true,
        "transparent": true
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "DeveloperTool",
    "shortDescription": "Troca de terminais entre worktrees",
    "longDescription": "Alterna entre worktrees de projetos com API e front em repositórios separados, com um terminal para cada lado.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4Q0RCREIzN0NERDUzN0YKUldSL1U5MThzNzNOK0NNNXFrYjhpdFl4MHpNM0FFY3BOT0J0Q280RjdIdTN3ZFpVNTJpM2ZRbUQK",
      "endpoints": [
        "https://github.com/martinsgabriel1956/hotswap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
